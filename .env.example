# Storyhouse Environment Variables Template
# Copy this file to .env for local development
# Set these in Netlify UI for production: Site settings > Environment variables

# ===========================================
# REQUIRED: Admin Credentials
# ===========================================
ADMIN_EMAIL=your-email@example.com
ADMIN_PASSWORD=your-strong-password-here

# ===========================================
# REQUIRED: Session Secret
# Generate with: openssl rand -hex 32
# ===========================================
SESSION_SECRET=your-32-character-random-secret-here

# ===========================================
# REQUIRED: Supabase Database Connection
# Get these from: https://app.supabase.com/project/_/settings/api
# ===========================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===========================================
# REQUIRED: Email Provider Configuration
# Choose ONE provider below and uncomment its settings
# ===========================================

# Option 1: Resend (Recommended - https://resend.com)
EMAIL_PROVIDER=resend
EMAIL_FROM=storyhouse@your-domain.com
RESEND_API_KEY=re_your-api-key-here

# Option 2: Postmark (https://postmarkapp.com)
# EMAIL_PROVIDER=postmark
# EMAIL_FROM=storyhouse@your-domain.com
# POSTMARK_API_KEY=your-postmark-key-here

# Option 3: Supabase Email (if enabled in your Supabase project)
# EMAIL_PROVIDER=supabase
# EMAIL_FROM=storyhouse@your-domain.com

# ===========================================
# OPTIONAL: Development Mode
# Set to "true" to show login codes in the UI instead of sending emails
# Useful for testing without email configuration
# ===========================================
# DEV_MODE=true

# ===========================================
# OPTIONAL: Application Settings
# ===========================================
# NODE_ENV=production
# PORT=3000
